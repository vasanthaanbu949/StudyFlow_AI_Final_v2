# Copy this file to  .streamlit/secrets.toml  (local)  or paste its contents into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# NEVER upload the real secrets.toml to GitHub (.gitignore already blocks it).

# ---- 1. Google sign-in (required for accounts + saving) ----------------------
[auth]
# Local testing:      https://studyflowaifinalv2-bk86rfl9jajz4lhkqw7pif.streamlit.app/oauth2callback
# Streamlit Cloud:    https://studyflow-ai-t9tysmwmjwodxgw3nexqbz.streamlit.app//oauth2callback
redirect_uri = "https://studyflowaifinalv2-bk86rfl9jajz4lhkqw7pif.streamlit.app/oauth2callback"
# Any long random string, e.g. run:  python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

[auth.google]
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- 2. Permanent storage (recommended on Streamlit Cloud) -------------------
# Leave this section out to use a local SQLite file (fine on your own computer,
# but erased whenever Streamlit Cloud restarts the app).
[database]
url = "postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- 3. E-mail the plan to the student's Gmail (optional) --------------------
# A Gmail account that SENDS the e-mails, plus its 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
[email]
sender = "your.sender.account@gmail.com"
app_password = "abcd efgh ijkl mnop"
